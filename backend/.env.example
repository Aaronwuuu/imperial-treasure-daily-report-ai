# 复制此文件为 .env，然后填写 OpenAI API Key。
# 不要把真实 Key 发给其他人或提交到代码仓库。
OPENAI_API_KEY=sk-your-key-here

# 周报和月报使用的模型。默认兼顾分析质量和成本。
OPENAI_REPORT_MODEL=gpt-5.6-terra

# 三种页面权限的访问码。请换成只有对应人员知道的号码或短语。
MANAGER_ACCESS_CODE=change-manager-code
LEADER_ACCESS_CODE=change-leader-code
EMPLOYEE_ACCESS_CODE=change-employee-code
